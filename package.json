{
  "name": "agentdash",
  "version": "0.0.0",
  "description": "A self-hosted dashboard written by AI agents over MCP and read in the browser",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts --data-dir .data/dev",
    "build:web": "vite build",
    "check": "biome ci . && tsc && vitest run",
    "fix": "biome check --write .",
    "test": "vitest",
    "e2e": "vite build && playwright test",
    "verify": "npm run check && npm run e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/inspector": "2.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "bin": {
    "agentdash": "src/main.ts"
  }
}
